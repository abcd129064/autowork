# 解释器与打包缓存
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
develop-eggs/

# 构建与发布产物（整目录可重建，不入库）
/build/
/dist/
# 更新发布打包产物（tools/deploy/publish_update.py 输出，含大 zip，不入库）
/out/

# 本地虚拟环境
venv/
env/
ENV/

# 编辑器与操作系统杂项
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Qt 编译中间物
*.ui.c

# 业务数据、日志与本地配置（含客户库存/凭据，禁止入库）
database/*.db
database/*.db-shm
database/*.db-wal
/logs/
videos/*
!videos/.gitkeep
settings.json
moyu_state.json

# 本地凭据与备份文件（含 DeepSeek API Key 等明文，禁止入库）
config/credentials.json
settings.json.bak

# frpc 隧道配置（含内网地址等敏感信息，不提交）
frpc_xtcp.toml
frpc_xtcp_panel.toml
frpc_xtcp_meta.json
frpc.exe

*.whl

.workbuddy
.qoder

# 前端依赖（原文件曾被工具追加 1.4 万行逐文件条目，2026-09-07 压缩重建，
# 备份见 /tmp/gitignore_backup_1MB）
node_modules/

# 整目录忽略（含本地凭据）
/config

# 压测结果快照（运行产物）
tools/stress_test/results/

# 测试运行截图产物（历史遗留规则；现在验证截图统一落 tools/_scratch/）
tests/*.png

# 一次性设计/验证产物（2026-09-20 版本管理盘点）
web/aftersale_front/tools/*.png
# 前端构建产物（/dist/ 已锚定为仓库根，这里补子目录）
web/**/dist/
.pytest_cache/
# 业务数据表（含客户库存，不入库）
总部仓库库存明细.xlsx

# Agent / 开发临时产物统一落点（探针脚本、截图、抓取物、中间输出）
# 规则见根目录 AGENTS.md；目录本身保留，内容全部不入库
tools/_scratch/*
!tools/_scratch/.gitkeep

/frp-dev
/version.json
